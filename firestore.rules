rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function registered() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function mine(uid) {
      return registered() && request.auth.uid == uid;
    }

    function isAdmin() {
      return registered()
        && request.auth.uid == "VPjjYv2NOdXMTTTxynB1MHTrfx23";
    }

    function bookOwner(bookId) {
      return registered()
        && get(/databases/$(database)/documents/livros/$(bookId)).data.criadoPor == request.auth.uid;
    }

    function followId(userId, authorId) {
      return userId + "_" + authorId;
    }

    function bookLikeId(bookId, userId) {
      return bookId + "_" + userId;
    }

    function followersArePublic(uid) {
      let data = get(/databases/$(database)/documents/autores/$(uid)).data;
      return !("privacidadeSeguidores" in data) || data.privacidadeSeguidores == "publico";
    }

    function followingIsPublic(uid) {
      let data = get(/databases/$(database)/documents/autores/$(uid)).data;
      return !("privacidadeSeguindo" in data) || data.privacidadeSeguindo == "publico";
    }

    function readingIsPublic(uid) {
      let data = get(/databases/$(database)/documents/autores/$(uid)).data;
      return !("privacidadeLeituras" in data) || data.privacidadeLeituras == "publico";
    }

    function canReceiveMessages(targetUid) {
      let data = get(/databases/$(database)/documents/autores/$(targetUid)).data;
      return !("privacidadeMensagens" in data)
        || data.privacidadeMensagens == "todos"
        || (
          data.privacidadeMensagens == "seguindo"
          && exists(
            /databases/$(database)/documents/seguindoAutores/$(followId(targetUid, request.auth.uid))
          )
        );
    }

    function conversationTarget(data) {
      return data.participanteA == request.auth.uid
        ? data.participanteB
        : data.participanteA;
    }

    // ==============================
    // USUÁRIOS
    // ==============================

    match /usuarios/{uid} {
      allow create:
        if mine(uid)
        && request.resource.data.uid == uid;

      allow get:
        if mine(uid) || isAdmin();

      allow update:
        if mine(uid) || isAdmin();

      allow delete:
        if mine(uid) || isAdmin();

      allow list:
        if isAdmin();
    }

    // Espelho seguro de "quem eu sigo".
    match /usuarios/{uid}/seguindo/{authorId} {
      allow read:
        if mine(uid)
        || followingIsPublic(uid);

      allow create, update:
        if mine(uid)
        && request.resource.data.usuarioId == uid
        && request.resource.data.autorId == authorId
        && uid != authorId;

      allow delete:
        if mine(uid) || isAdmin();
    }

    // ==============================
    // PERFIL PÚBLICO DE AUTORES
    // ==============================

    match /autores/{uid} {
      allow read:
        if true;

      allow create, update, delete:
        if mine(uid) || isAdmin();
    }

    // Espelho seguro de "quem me segue".
    match /autores/{uid}/seguidores/{followerId} {
      allow read:
        if mine(uid)
        || followersArePublic(uid);

      allow create, update:
        if registered()
        && request.resource.data.usuarioId == followerId
        && request.resource.data.autorId == uid
        && followerId != uid
        && (
          request.auth.uid == followerId
          || (
            request.auth.uid == uid
            && exists(
              /databases/$(database)/documents/seguindoAutores/$(followId(followerId, uid))
            )
          )
        );

      allow delete:
        if registered()
        && (
          request.auth.uid == followerId
          || request.auth.uid == uid
          || isAdmin()
        );
    }

    // ==============================
    // LIVROS
    // ==============================

    match /livros/{bookId} {
      allow get:
        if resource.data.status == "publicado"
        || (
          registered()
          && resource.data.criadoPor == request.auth.uid
        )
        || isAdmin();

      allow list:
        if resource.data.status == "publicado"
        || (
          registered()
          && resource.data.criadoPor == request.auth.uid
        )
        || isAdmin();

      allow create:
        if registered()
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.sinopse is string
        && request.resource.data.autor is string
        && request.resource.data.autor.size() > 0
        && request.resource.data.status in ["rascunho", "publicado"];

      allow update:
        if (
          registered()
          && resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoPor == resource.data.criadoPor
        )
        || isAdmin();

      allow delete:
        if (
          registered()
          && resource.data.criadoPor == request.auth.uid
        )
        || isAdmin();
    }

    // ==============================
    // CAPÍTULOS
    // ==============================

    match /capitulos/{chapterId} {
      allow get:
        if resource.data.status == "publicado"
        || bookOwner(resource.data.livroId)
        || isAdmin();

      allow list:
        if resource.data.status == "publicado"
        || bookOwner(resource.data.livroId)
        || isAdmin();

      allow create:
        if registered()
        && request.resource.data.criadoPor == request.auth.uid
        && bookOwner(request.resource.data.livroId)
        && request.resource.data.status in ["rascunho", "publicado"]
        && request.resource.data.numero is number
        && request.resource.data.numero >= 1
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0;

      allow update:
        if (
          registered()
          && bookOwner(resource.data.livroId)
          && request.resource.data.livroId == resource.data.livroId
          && request.resource.data.criadoPor == resource.data.criadoPor
        )
        || isAdmin();

      allow delete:
        if (
          registered()
          && bookOwner(resource.data.livroId)
        )
        || isAdmin();
    }

    // ==============================
    // FAVORITOS / BIBLIOTECA
    // ==============================

    match /favoritos/{favoriteId} {
      allow get:
        if registered()
        && favoriteId.matches(request.auth.uid + '_.*');

      allow list:
        if registered()
        && resource.data.usuarioId == request.auth.uid;

      allow create:
        if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && favoriteId == request.auth.uid + "_" + request.resource.data.livroId;

      allow delete:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
        )
        || isAdmin();

      allow update:
        if false;
    }

    // ==============================
    // PROGRESSO DE LEITURA
    // ==============================

    match /progressoLeitura/{progressId} {
      allow read:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
        )
        || readingIsPublic(resource.data.usuarioId);

      allow create:
        if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && progressId == request.auth.uid + "_" + request.resource.data.livroId;

      allow update:
        if registered()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid;

      allow delete:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
        )
        || isAdmin();
    }

    // ==============================
    // SEGUIR AUTORES - BASE LEGADA PRIVADA
    // ==============================

    match /seguindoAutores/{followId} {
      allow get:
        if registered()
        && (
          followId.matches(request.auth.uid + '_.*')
          || resource.data.autorId == request.auth.uid
        );

      allow list:
        if registered()
        && (
          resource.data.usuarioId == request.auth.uid
          || resource.data.autorId == request.auth.uid
        );

      allow create:
        if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.autorId is string
        && request.resource.data.autorId != request.auth.uid
        && followId == request.auth.uid + "_" + request.resource.data.autorId;

      allow delete:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
        )
        || isAdmin();

      allow update:
        if false;
    }

    // ==============================
    // CONVERSAS E MENSAGENS PRIVADAS
    // ==============================

    match /conversas/{conversationId} {
      allow get, list:
        if registered()
        && request.auth.uid in resource.data.participantes;

      allow create:
        if registered()
        && request.resource.data.participantes is list
        && request.resource.data.participantes.size() == 2
        && request.auth.uid in request.resource.data.participantes
        && request.resource.data.participanteA in request.resource.data.participantes
        && request.resource.data.participanteB in request.resource.data.participantes
        && request.resource.data.participanteA != request.resource.data.participanteB
        && canReceiveMessages(conversationTarget(request.resource.data));

      allow update:
        if registered()
        && request.auth.uid in resource.data.participantes
        && request.resource.data.participantes == resource.data.participantes
        && request.resource.data.participanteA == resource.data.participanteA
        && request.resource.data.participanteB == resource.data.participanteB;

      allow delete:
        if isAdmin();

      match /mensagens/{messageId} {
        allow read:
          if registered()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversas/$(conversationId)
          ).data.participantes;

        allow create:
          if registered()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversas/$(conversationId)
          ).data.participantes
          && request.resource.data.remetenteId == request.auth.uid
          && request.resource.data.destinatarioId in get(
            /databases/$(database)/documents/conversas/$(conversationId)
          ).data.participantes
          && request.resource.data.destinatarioId != request.auth.uid
          && request.resource.data.tipo in ["texto", "imagem", "audio"]
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 4000
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() <= 1200
          && request.resource.data.cloudinaryPublicId is string
          && request.resource.data.cloudinaryPublicId.size() <= 500
          && request.resource.data.cloudinaryResourceType is string
          && request.resource.data.cloudinaryResourceType.size() <= 20
          && request.resource.data.cloudinaryFormat is string
          && request.resource.data.cloudinaryFormat.size() <= 20
          && request.resource.data.mediaBytes is number
          && request.resource.data.mediaBytes >= 0
          && request.resource.data.mediaBytes <= 15728640
          && (
            (
              request.resource.data.tipo == "texto"
              && request.resource.data.mediaUrl == ""
            )
            || (
              request.resource.data.tipo in ["imagem", "audio"]
              && request.resource.data.mediaUrl.matches(
                'https://res[.]cloudinary[.]com/dzsf7cwf/.*'
              )
            )
          );

        allow update:
          if false;

        allow delete:
          if (
            registered()
            && resource.data.remetenteId == request.auth.uid
          )
          || isAdmin();
      }
    }

    // ==============================
    // NOTIFICAÇÕES
    // ==============================

    match /notificacoes/{notificationId} {
      allow get, list:
        if registered()
        && resource.data.destinatarioId == request.auth.uid;

      allow create:
        if registered()
        && request.resource.data.remetenteId == request.auth.uid
        && request.resource.data.destinatarioId is string
        && request.resource.data.destinatarioId != request.auth.uid
        && request.resource.data.tipo in ["mensagem", "seguidor", "comentario", "avaliacao", "curtida_livro"]
        && (
          (
            request.resource.data.tipo == "mensagem"
            && request.resource.data.conversaId is string
            && request.auth.uid in get(
              /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
            ).data.participantes
            && request.resource.data.destinatarioId in get(
              /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
            ).data.participantes
          )
          || (
            request.resource.data.tipo == "seguidor"
            && exists(
              /databases/$(database)/documents/seguindoAutores/$(followId(request.auth.uid, request.resource.data.destinatarioId))
            )
          )
          || (
            request.resource.data.tipo == "comentario"
            && request.resource.data.livroId is string
            && get(
              /databases/$(database)/documents/livros/$(request.resource.data.livroId)
            ).data.criadoPor == request.resource.data.destinatarioId
          )
          || (
            request.resource.data.tipo == "avaliacao"
            && request.resource.data.livroId is string
            && get(
              /databases/$(database)/documents/livros/$(request.resource.data.livroId)
            ).data.criadoPor == request.resource.data.destinatarioId
          )
          || (
            request.resource.data.tipo == "curtida_livro"
            && request.resource.data.livroId is string
            && get(
              /databases/$(database)/documents/livros/$(request.resource.data.livroId)
            ).data.criadoPor == request.resource.data.destinatarioId
            && exists(
              /databases/$(database)/documents/curtidasLivros/$(bookLikeId(request.resource.data.livroId, request.auth.uid))
            )
          )
        );

      allow update:
        if registered()
        && resource.data.destinatarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lida"]);

      allow delete:
        if (
          registered()
          && resource.data.destinatarioId == request.auth.uid
        )
        || isAdmin();
    }

    // ==============================
    // AVALIAÇÕES
    // ==============================

    match /avaliacoes/{ratingId} {
      allow read:
        if true;

      allow create:
        if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.livroId is string
        && request.resource.data.livroId.size() > 0
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5
        && ratingId == request.resource.data.livroId + "_" + request.auth.uid;

      allow update:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.livroId == resource.data.livroId
          && request.resource.data.nota is int
          && request.resource.data.nota >= 1
          && request.resource.data.nota <= 5
          && ratingId == request.resource.data.livroId + "_" + request.auth.uid
        )
        || isAdmin();

      allow delete:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
        )
        || isAdmin();
    }

    // ==============================
    // COMENTÁRIOS
    // ==============================

    match /comentarios/{commentId} {
      allow read:
        if true;

      allow create:
        if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.capituloId is string
        && request.resource.data.capituloId.size() > 0
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 2
        && request.resource.data.comentario.size() <= 1200;

      allow update:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.comentario is string
          && request.resource.data.comentario.size() >= 2
          && request.resource.data.comentario.size() <= 1200
        )
        || isAdmin();

      allow delete:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
        )
        || isAdmin();
    }

    // ==============================
    // VISUALIZAÇÕES DE CAPÍTULOS
    // ==============================

    match /visualizacoesCapitulos/{viewId} {
      allow read:
        if signedIn();

      allow create:
        if signedIn()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.capituloId is string
        && request.resource.data.capituloId.size() > 0
        && viewId == request.resource.data.capituloId + "_" + request.auth.uid;

      allow update:
        if false;

      allow delete:
        if isAdmin();
    }

    // ==============================
    // CURTIDAS DE LIVROS
    // ==============================

    match /curtidasLivros/{likeId} {
      allow read:
        if true;

      allow create:
        if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.livroId is string
        && request.resource.data.livroId.size() > 0
        && likeId == request.resource.data.livroId + "_" + request.auth.uid;

      allow delete:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
        )
        || isAdmin();

      allow update:
        if false;
    }

    // ==============================
    // CURTIDAS DE CAPÍTULOS
    // ==============================

    match /curtidasCapitulos/{likeId} {
      allow read:
        if signedIn();

      allow create:
        if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.capituloId is string
        && likeId == request.resource.data.capituloId + "_" + request.auth.uid;

      allow delete:
        if (
          registered()
          && resource.data.usuarioId == request.auth.uid
        )
        || isAdmin();

      allow update:
        if false;
    }
  }
}
