rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function registered() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }
    function mine(uid) { return registered() && request.auth.uid == uid; }
    function isAdmin() { return registered() && request.auth.token.admin == true; }
    function bookOwner(bookId) {
      return registered()
        && get(/databases/$(database)/documents/livros/$(bookId)).data.criadoPor == request.auth.uid;
    }

    match /usuarios/{uid} {
      allow create: if mine(uid) && request.resource.data.uid == uid;
      allow get, update, delete: if mine(uid);
      allow list: if false;
    }

    match /autores/{uid} {
      allow read: if true;
      allow create, update, delete: if mine(uid);
    }

    match /livros/{bookId} {
      allow get: if resource.data.status == "publicado"
        || (registered() && resource.data.criadoPor == request.auth.uid)
        || isAdmin();
      allow list: if resource.data.status == "publicado"
        || (registered() && resource.data.criadoPor == request.auth.uid)
        || isAdmin();
      allow create: if registered()
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.sinopse is string
        && request.resource.data.autor is string
        && request.resource.data.status in ["rascunho","publicado"];
      allow update: if registered()
        && resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoPor == resource.data.criadoPor;
      allow delete: if registered() && resource.data.criadoPor == request.auth.uid;
    }

    match /capitulos/{chapterId} {
      allow get: if resource.data.status == "publicado"
        || bookOwner(resource.data.livroId)
        || isAdmin();
      allow list: if resource.data.status == "publicado"
        || bookOwner(resource.data.livroId)
        || isAdmin();
      allow create: if registered()
        && request.resource.data.criadoPor == request.auth.uid
        && bookOwner(request.resource.data.livroId)
        && request.resource.data.status in ["rascunho","publicado"]
        && request.resource.data.numero is number;
      allow update: if registered()
        && bookOwner(resource.data.livroId)
        && request.resource.data.livroId == resource.data.livroId
        && request.resource.data.criadoPor == resource.data.criadoPor;
      allow delete: if registered() && bookOwner(resource.data.livroId);
    }

    match /favoritos/{favoriteId} {
      allow read: if registered() && resource.data.usuarioId == request.auth.uid;
      allow create: if registered() && request.resource.data.usuarioId == request.auth.uid;
      allow delete: if registered() && resource.data.usuarioId == request.auth.uid;
      allow update: if false;
    }

    match /progressoLeitura/{progressId} {
      allow read: if registered() && resource.data.usuarioId == request.auth.uid;
      allow create: if registered() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if registered()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid;
      allow delete: if registered() && resource.data.usuarioId == request.auth.uid;
    }

    match /seguindoAutores/{followId} {
      allow read: if registered() && resource.data.usuarioId == request.auth.uid;
      allow create: if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.autorId is string;
      allow delete: if registered() && resource.data.usuarioId == request.auth.uid;
      allow update: if false;
    }

    match /avaliacoes/{ratingId} {
      allow read: if true;
      allow create, update: if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5;
      allow delete: if registered() && resource.data.usuarioId == request.auth.uid;
    }

    match /comentarios/{commentId} {
      allow read: if true;
      allow create: if registered()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 2
        && request.resource.data.comentario.size() <= 1200;
      allow update: if registered()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == resource.data.usuarioId;
      allow delete: if (registered() && resource.data.usuarioId == request.auth.uid) || isAdmin();
    }

    match /visualizacoesCapitulos/{viewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.capituloId is string;
      allow update, delete: if false;
    }

    match /curtidasCapitulos/{likeId} {
      allow read: if signedIn();
      allow create: if registered()
        && request.resource.data.usuarioId == request.auth.uid;
      allow delete: if registered()
        && resource.data.usuarioId == request.auth.uid;
      allow update: if false;
    }
  }
}
